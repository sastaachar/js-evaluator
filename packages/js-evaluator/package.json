{
  "name": "js-evaluator",
  "version": "0.1.1",
  "description": "Run JavaScript inside a sandboxed iframe and stream console output, results and errors back to the host page.",
  "type": "module",
  "license": "ISC",
  "author": "sastaachar",
  "homepage": "https://sastaachar.github.io/js-evaluator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sastaachar/js-evaluator.git",
    "directory": "packages/js-evaluator"
  },
  "bugs": {
    "url": "https://github.com/sastaachar/js-evaluator/issues"
  },
  "keywords": [
    "sandbox",
    "iframe",
    "eval",
    "evaluator",
    "postmessage",
    "code-runner",
    "playground",
    "repl"
  ],
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./sandbox/evaluator.js": "./src/sandbox/evaluator.js",
    "./sandbox/index.html": "./src/sandbox/index.html",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/sync-site.mjs --check"
  }
}
